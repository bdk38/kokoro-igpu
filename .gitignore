# Python / local env
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Runtime caches and local server logs (evidence copies live under artifacts/logs/)
cache/
logs/

# Model weights — download + patch locally (see README). Not in git/LFS.
models/**/*.onnx
models/**/*.bin
models/v1/
models/original-webui-models/
models/patched/*.onnx

# Keep directory placeholders
!models/**/.gitkeep
!models/patched/.gitkeep

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Secrets / local overrides
.env
.env.*
*.pem
# credential store must never be committed
**/github-credentials

# Ignore loose logs everywhere, then re-include evidence logs under artifacts/
*.log
!artifacts/logs/
!artifacts/logs/**

# Issue filing evidence logs
!issues/captures/
!issues/captures/**


# Spike decoder ONNX weights — rebuild via spike/g2_export.py (too large for git).
# Tiny OV-GPU repro graphs for filing are force-added under diagnosis/minimal_conv1d/ if needed.
spike/out/**/*.onnx
spike/**/__pycache__/

# Side / research venvs
venv-s0-ov263/
venv-poc-*/

# Local backups
*.bak
*.bak-*
WORKFLOW.md.bak*

# Large spike IR/cache (rebuild locally)
spike/out/g2/*.bin
spike/out/g3/ov_cache/
spike/ov263-genai/out/kokoro-82M-int8-ov/
spike/ov263-genai/out/**/ov_cache*/

# Official pack weights (download — see MODELS.md); keep identity sidecar trackable if force-added
models/kokoro-82M-int8-ov/**
!models/kokoro-82M-int8-ov/SHIP_PACK_IDENTITY.txt
!models/kokoro-82M-int8-ov/README.md
!models/kokoro-82M-int8-ov/config.json
!models/kokoro-82M-int8-ov/openvino_config.json
